# Template for secrets.yaml
# After generating your age keys and updating .sops.yaml with the public keys:
#
# 1. Copy this to secrets.yaml:
#    cp secrets.yaml.template secrets.yaml
#
# 2. Encrypt it:
#    sops -e -i secrets.yaml
#
# 3. Edit encrypted file (sops decrypts in your editor, re-encrypts on save):
#    sops secrets.yaml
#
# Structure example:
example-api-key: "YOUR_API_KEY_HERE"
another-secret: "YOUR_SECRET_HERE"
